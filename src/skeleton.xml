                  </b:loop>
                </ul>
              </div>
            </b:includable>
          </b:widget>
          </b:section></div>
        <div class='cm-foot-col cm-lay'><b:section class='cm-foot-s' id='footer-3' maxwidgets='3' name='Footer 3 - Up to 3 gadgets' showaddelement='yes'>
