  <footer class='cm-footer cm-lay' id='cm-footer'>
    <div class='cm-foot-in cm-lay'>
      <div class='cm-foot-top cm-lay'>
        <div class='cm-footbrand'>
          <strong class='cm-footname'><b:eval expr='data:skin.vars.brandName != &quot;&quot; ? data:skin.vars.brandName : data:blog.title'/></strong>
          <p><data:skin.vars.tagline/></p>
          <div class='cm-social' expr:data-links='data:skin.vars.socialLinks'>
            <ul class='cm-links'/>
          </div>
          <div class='cm-footfollow'>
            <span class='cm-footfollow-t'>Follow this blog</span>
            <a class='cm-followers-btn' expr:href='&quot;https://www.blogger.com/follow-blog.g?blogID=&quot; + data:blog.blogId' rel='nofollow noopener' target='_blank'><svg aria-hidden='true' height='16' viewBox='0 0 24 24' width='16'><path d='M15 12c2.2 0 4-1.8 4-4s-1.8-4-4-4-4 1.8-4 4 1.8 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.7 0-8 1.3-8 4v2h16v-2c0-2.7-5.3-4-8-4z' fill='currentColor'/></svg>Follow</a>
            <div class='cm-followers-grid' id='cm-foot-followers'/>
          </div>
          <b:if cond='data:skin.vars.newsletterAction != &quot;&quot; and data:skin.vars.showNewsletter == &quot;yes&quot;'>
            <form class='cm-subform' expr:action='data:skin.vars.newsletterAction' id='cm-subscribe' method='post' target='_blank'>
              <label class='cm-sublabel' for='cm-sub-email'><data:skin.vars.newsletterTitle/></label>
              <div class='cm-subrow'>
                <input id='cm-sub-email' name='EMAIL' placeholder='you@example.com' required='required' type='email'/>
                <button class='cm-btn' type='submit'>Subscribe</button>
              </div>
            </form>
          </b:if>
        </div>
        <div class='cm-foot-col cm-lay'><b:section class='cm-foot-s' id='footer-1' maxwidgets='3' name='Footer 1 - Up to 3 gadgets' showaddelement='yes'>
          <b:widget id='LinkList151' locked='false' title='Quick links' type='LinkList' version='2' visible='true'>
            <b:widget-settings>
              <b:widget-setting name='sorting'>NONE</b:widget-setting>
              <b:widget-setting name='text-0'>All articles</b:widget-setting>
              <b:widget-setting name='link-0'>/search</b:widget-setting>
              <b:widget-setting name='text-1'>About</b:widget-setting>
              <b:widget-setting name='link-1'>/p/about.html</b:widget-setting>
              <b:widget-setting name='text-2'>Contact</b:widget-setting>
              <b:widget-setting name='link-2'>/p/contact.html</b:widget-setting>
            </b:widget-settings>
            <b:includable id='main' var='this'>
              <b:include name='widget-title'/>
              <div class='widget-content'>
                <ul>
                  <b:loop values='data:links' var='link'>
                    <li><a expr:href='data:link.target'><data:link.name/></a></li>
                  </b:loop>
                </ul>
              </div>
            </b:includable>
          </b:widget>
          </b:section></div>
        <div class='cm-foot-col cm-lay'><b:section class='cm-foot-s' id='footer-2' maxwidgets='3' name='Footer 2 - Up to 3 gadgets' showaddelement='yes'>
          <b:widget id='Label152' locked='false' title='Categories' type='Label' version='2' visible='true'>
            <b:widget-settings>
              <b:widget-setting name='sorting'>ALPHA</b:widget-setting>
              <b:widget-setting name='display'>LIST</b:widget-setting>
              <b:widget-setting name='selectedLabelsList'/>
              <b:widget-setting name='showType'>ALL</b:widget-setting>
